<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ platform SplashScreen API (no compat library required). -->
    <style name="Theme.ArtikelMeister" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/brand_splash_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenBackground">@color/brand_splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/brand_splash_background</item>
    </style>
</resources>
